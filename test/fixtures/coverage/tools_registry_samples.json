                  "runtimeArguments": [
                    {
                      "isRequired": true,
                      "value": "--root"
                    }
                  ],
                  "packageArguments": [
                    {
                      "isRequired": false,
                      "value": "--quiet"
                    }
                  ]
                }
              ]
            },
            "_meta": {
              "io.modelcontextprotocol.registry/official": {
                "status": "active"
              }
