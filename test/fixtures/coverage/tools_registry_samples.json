      "payload": {
        "servers": [
          {
            "server": {
              "name": "io.example/weather",
              "version": "1.2.0",
              "description": "Forecasts and alerts for any city",
              "title": "Weather lookups",
              "remotes": [
                {
                  "type": "streamable-http",
                  "url": "https://mcp.weather.example/mcp",
                  "headers": [
                    {
                      "name": "X-Api-Key",
                      "isRequired": true,
                      "isSecret": true,
                      "value": "sk-test-0000000000000000",
                      "default": "sk-default-000000000000",
                      "description": "Your weather key"
                    }
                  ],
                  "variables": {
                    "region": {
                      "description": "Region",
                      "default": "eu"
                    }
                  }
                }
              ]
            },
