# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/
.claude/worktrees/

# Developer agent prompt packs are third-party content installed locally.
# See CONTRIBUTING.md — they are not part of this repository.
.claude/skills/

# Local opencode session configuration (agents, commands, node_modules) is
# machine-specific and must never be committed.
.opencode/

# APKs are distributed as release assets, not source files.
/*.apk
COMMIT_MSG.txt

# Native phone-engine build outputs stay off the root disk.
/engine/phone/target/
/engine/phone/artifacts/

# Screen recordings stay out of the public tree (G25)
docs/qa/**/*.mp4

# native UI rebuild gate output
/looks-gate/
/looks-out/

# Private Firebase config (never commit)
google-services.json
native/androidApp/src/*/google-services.json
# Private Firebase config
google-services*.json

# Release signing. The key file lives at native/key.properties (native/.gitignore) or is named by OC_KEY_PROPERTIES;
# the old android/key.properties and any keystore stay ignored even after the Flutter folders are gone.
/android/key.properties
*.jks
*.keystore

# Leftovers of the removed Flutter app in older checkouts (build output, local SDK paths, keys): ignored so they are
# never committed by accident. Delete them by hand when convenient.
/android/
/ios/
/widgetbook/
/build/
/coverage/
.dart_tool/
.flutter-plugins-dependencies
/test/**/failures/
