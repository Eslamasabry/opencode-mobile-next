<?xml version="1.0" encoding="utf-8"?>
<!-- One more conversation on a tall card: a hairline, its title and one state line. No buttons:
     the card answers one request, the app answers the rest. Rows share the height they are given
     (the card only adds whole 50dp rows), so no band is left under the last one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wc_row"
    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:minHeight="50dp" android:orientation="vertical"
    android:layoutDirection="locale">
    <FrameLayout android:id="@+id/wc_divider" android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#1AFFFFFF" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:id="@+id/wc_row_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"
            android:textDirection="firstStrong" android:gravity="start" android:textColor="#FFF3F3F1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:gravity="center_vertical">
            <ImageView android:id="@+id/wc_row_dot" android:layout_width="6dp" android:layout_height="6dp"
                android:layout_marginEnd="6dp" android:src="@drawable/widget_dot" android:importantForAccessibility="no"
                android:visibility="gone" />
            <Chronometer android:id="@+id/wc_row_state" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
                android:textDirection="firstStrong" android:gravity="start" android:textColor="#FF8C8F96" />
            <TextView android:id="@+id/wc_row_state_still" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
                android:textDirection="firstStrong" android:gravity="start" android:textColor="#FF8C8F96" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
