# Copy to private.env (git-ignored) and fill in. Never commit private.env.
SHOTS_PASEO_DIR=/path/to/paseo/workspace
SHOTS_PASEO_BIN=/path/to/paseo
SHOTS_PASEO_HOST=127.0.0.1
SHOTS_OPENCODE_BIN=/path/to/opencode
# Words that must never appear on a captured screen (user name, host name, addresses, email).
SHOTS_FORBIDDEN=yourname,yourhost,you@example.com
