# Merge rule: the driver is repo-local git config; the integrator sets it once:
#   git config merge.ours.name "keep ours (regenerated after the merge)"
#   git config merge.ours.driver true

# Generated by docs/design/ui-ledger/build_ledger.py after every integration.
docs/design/ui-ledger/ledger.json merge=ours
docs/design/ui-ledger/pages.md merge=ours
docs/design/ui-ledger/navigation.md merge=ours

# GitHub's language bar: count the app, not the host tools, demo video or docs.
tool/** linguist-detectable=false
docs/** linguist-documentation
