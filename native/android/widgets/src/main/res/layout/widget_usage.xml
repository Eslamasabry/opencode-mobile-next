                <ProgressBar android:id="@+id/usage_c2_bar_1" style="@style/WidgetUsageBar" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/usage_detail_1" style="@style/WidgetUsageDetail" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/usage_row_2"
