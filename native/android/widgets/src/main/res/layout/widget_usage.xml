                <ProgressBar android:id="@+id/usage_c2_bar_5" style="@style/WidgetUsageBar" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/usage_detail_5" style="@style/WidgetUsageDetail" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
