                <ProgressBar android:id="@+id/usage_c2_bar_2" style="@style/WidgetUsageBar" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/usage_detail_2" style="@style/WidgetUsageDetail" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/usage_row_3"
        style="@style/WidgetUsageRow">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/usage_title_3" style="@style/WidgetUsageTitle" />
            <TextView android:id="@+id/usage_left_3" style="@style/WidgetUsageLeft" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/usage_cols_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout style="@style/WidgetUsageColumn">
                <TextView android:id="@+id/usage_c1_text_3" style="@style/WidgetUsageColumnText" />
                <ProgressBar android:id="@+id/usage_c1_bar_3" style="@style/WidgetUsageBar" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/usage_c2_3"
                style="@style/WidgetUsageColumn"
                android:layout_marginStart="12dp">
                <TextView android:id="@+id/usage_c2_text_3" style="@style/WidgetUsageColumnText" />
                <ProgressBar android:id="@+id/usage_c2_bar_3" style="@style/WidgetUsageBar" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/usage_detail_3" style="@style/WidgetUsageDetail" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/usage_row_4"
        style="@style/WidgetUsageRow">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/usage_title_4" style="@style/WidgetUsageTitle" />
            <TextView android:id="@+id/usage_left_4" style="@style/WidgetUsageLeft" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/usage_cols_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout style="@style/WidgetUsageColumn">
                <TextView android:id="@+id/usage_c1_text_4" style="@style/WidgetUsageColumnText" />
                <ProgressBar android:id="@+id/usage_c1_bar_4" style="@style/WidgetUsageBar" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/usage_c2_4"
                style="@style/WidgetUsageColumn"
                android:layout_marginStart="12dp">
                <TextView android:id="@+id/usage_c2_text_4" style="@style/WidgetUsageColumnText" />
                <ProgressBar android:id="@+id/usage_c2_bar_4" style="@style/WidgetUsageBar" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/usage_detail_4" style="@style/WidgetUsageDetail" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/usage_row_5"
        style="@style/WidgetUsageRow">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
