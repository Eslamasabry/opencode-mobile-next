<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The started/finished notices of scheduled runs (Android 13+ asks the person once). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact alarms keep a run on time through Doze (Flutter held this grant; WorkManager is the fallback). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!--
            The notification trampoline lives in :androidApp (it reaches the app graph); it routes the tap
            (B-NAV-054), opens MainActivity and finishes. Not exported: only our own PendingIntents start it.
        -->
        <activity
            android:name="io.github.eslamasabry.opencode_mobile.graph.ScheduleOpenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!--
            Frozen Flutter class name (its pending alarms and manifest name it). Re-arms after boot, an update (also the
            Flutter → native one before the app is opened) and clock changes; starts a native exact alarm's run.
        -->
        <receiver
            android:name="io.github.eslamasabry.opencode_mobile.ScheduledPromptReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
