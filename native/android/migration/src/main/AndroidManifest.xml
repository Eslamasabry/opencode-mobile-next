<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Starts the P5 proof thread at process start, before Application.onCreate and before anything opens prefs. -->
        <provider
            android:name="io.github.eslamasabry.oc.android.migration.P5ProofProvider"
            android:authorities="${applicationId}.p5proof"
            android:exported="false"
            android:initOrder="1000" />
    </application>
</manifest>
