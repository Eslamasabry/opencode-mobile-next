<?xml version="1.0" encoding="utf-8"?>
<!-- Slice 0: only the components already built (plan 03 §22.1). Every later component keeps its frozen FQCN. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Settings › Notifications: Android 13+ lets the app notify only with this declared (P12-SETTINGS). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OcApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:label="@string/app_label_preview"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share target (P12-PLATFORM): text shared from any app lands in a new conversation's draft. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Static launcher shortcuts (Connect, New conversation), ids as in the Flutter app. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Notification buttons (P12-PLATFORM); frozen Flutter FQCNs. Tiles, widgets and the update receiver merge
             from :android:tiles and :android:widgets. -->
        <receiver
            android:name=".CodingActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".StatusActionReceiver"
            android:exported="false" />
    </application>
</manifest>
