<?xml version="1.0" encoding="utf-8"?>
<!-- Slice 0: only the components already built (plan 03 §22.1). Every later component keeps its frozen FQCN. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Raw project paths inside selected proot mounts require Android file access. Requested only from a visible folder action
         (a shared-storage project on this phone, or folder access granted in Settings), never at startup or for a remote host. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Settings › Notifications: Android 13+ lets the app notify only with this declared (P12-SETTINGS). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Connect › Find on my network: reads the Wi-Fi's address range and looks for OpenCode on it. ACCESS_LOCAL_NETWORK is
         the Android 17 runtime permission for LAN access; it is asked only when the person taps "Find on my network". -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- P12-VOICE: voice typing uses the phone's speech recognizer; Android 11+ hides the service without this. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".OcApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:manageSpaceActivity=".ManageSpaceActivity"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_label_preview"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/NativeAppTheme">
        <!-- Crash reports are opt-in at run time (Settings > Privacy); nothing is collected until the person's answer is applied. -->
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- B-ANDR-072: the same single route-only VIEW filter as the Flutter app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opencode-mobile" android:host="session" />
                <data android:scheme="opencode-mobile" android:host="team" />
            </intent-filter>
            <!-- Share target (P12-PLATFORM): text shared from any app lands in a new conversation's draft. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Static launcher shortcuts (Connect, New conversation), ids as in the Flutter app. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <activity android:name=".IdleStartActivity" android:exported="false"
            android:excludeFromRecents="true" android:noHistory="true" android:theme="@style/NativeTrampolineTheme" />
        <activity
            android:name=".ManageSpaceActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- Widget trampoline (B-AGENT-317): shows nothing, like ScheduleOpenActivity. -->
        <activity android:name=".WidgetRouteActivity" android:exported="false" android:excludeFromRecents="true"
            android:noHistory="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".WidgetOverlayActivity" android:exported="false" android:excludeFromRecents="true" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".WidgetConfigureActivity" android:exported="true" android:excludeFromRecents="true" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <meta-data android:name="io.github.eslamasabry.opencode_mobile.WIDGET_OVERLAY_READY" android:value="true" />
        <activity
            android:name="io.github.eslamasabry.opencode_mobile.graph.ScheduleOpenActivity"
            android:theme="@style/NativeTrampolineTheme"
            tools:replace="android:theme" />
        <!-- Notification buttons (P12-PLATFORM); frozen Flutter FQCNs. Tiles, widgets and the update receiver merge
             from :android:tiles and :android:widgets. -->
        <receiver
            android:name=".CodingActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".StatusActionReceiver"
            android:exported="false" />
        <!-- BUILD-ANDROID-BG-PLATFORM: the live background connection (frozen Flutter FQCN, dataSync, 6 h/24 h). -->
        <service
            android:name=".BackgroundConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync|shortService" />
        <!-- P12 fix (Codex files #3, plan 10 §11.6 S4): untrusted PDFs are parsed only in this isolated process. -->
        <service
            android:name=".LocalPdfService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":local_pdf" />
        <!-- P12-FILES Open with: read-only grants to the private cache copy of one opened project file. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/oc_files_paths" />
        </provider>
        <receiver android:name=".LivePauseReceiver" android:exported="false" />
    </application>
</manifest>
