<?xml version="1.0" encoding="utf-8"?>
<!-- Slice 0: only the components already built (plan 03 §22.1). Every later component keeps its frozen FQCN. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- Settings › Notifications: Android 13+ lets the app notify only with this declared (P12-SETTINGS). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- P12-VOICE: voice typing uses the phone's speech recognizer; Android 11+ hides the service without this. -->
    <queries>
        <package android:name="com.termux" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".OcApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:label="@string/app_label_preview"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share target (P12-PLATFORM): text shared from any app lands in a new conversation's draft. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Static launcher shortcuts (Connect, New conversation), ids as in the Flutter app. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <service android:name="io.github.eslamasabry.oc.android.termux.GitRepairResultService" android:exported="false" />
        <!-- Notification buttons (P12-PLATFORM); frozen Flutter FQCNs. Tiles, widgets and the update receiver merge
             from :android:tiles and :android:widgets. -->
        <receiver
            android:name=".CodingActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".StatusActionReceiver"
            android:exported="false" />
        <!-- BUILD-ANDROID-BG-PLATFORM: the live background connection (frozen Flutter FQCN, dataSync, 6 h/24 h). -->
        <service
            android:name=".BackgroundConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync|shortService" />
        <!-- P12 fix (Codex files #3, plan 10 §11.6 S4): untrusted PDFs are parsed only in this isolated process. -->
        <service
            android:name=".LocalPdfService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":local_pdf" />
        <!-- P12-FILES Open with: read-only grants to the private cache copy of one opened project file. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/oc_files_paths" />
        </provider>
    </application>
</manifest>
