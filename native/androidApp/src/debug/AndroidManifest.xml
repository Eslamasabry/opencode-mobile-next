<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only P6 proof screen (slice 0). Never in a release build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <activity
            android:name=".LanguageProofActivity"
            android:exported="true" />
        <!-- Debug-only "send test report" for the crash-reporting proof (preview builds are debug builds). -->
        <receiver android:name=".TestReportReceiver" android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.TEST_REPORT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
