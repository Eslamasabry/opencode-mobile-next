# T2 steps (plan 02 §8): one Gradle invocation per line, "<step name><TAB><gradle args>". t2.sh runs them in order and
# records every step; a task Gradle cannot find is reported as MISSING, which is a failure, never a skip.
# The coordinator adds a line when the gate it names exists (size gate, R8 config analysis, catalog report ...).
build-logic	-p build-logic test
# E02-S11c: every module's unit-test sources compile (desktop, JVM and, with the SDK, Android); also part of :quality:test.
test-compile	--continue -Poc.testCompileGuard=all :quality:compileAllTestSources
test-compile	--continue compileAllTests
tests	--continue -Poc.werror=true desktopTest testAndroidHostTest test
goldens	--continue verifyRoborazziAndroidHostTest
lint	:androidApp:lintSwitchRelease
assemble	:androidApp:assembleSwitchRelease :androidApp:assemblePreviewRelease
component-freeze	:androidApp:processSwitchReleaseMainManifest :quality:test --tests *ComponentFreeze* -Poc.mergedManifest=required
r8-config	:androidApp:analyzeSwitchReleaseR8Config
catalog-report	:quality:catalogReport
