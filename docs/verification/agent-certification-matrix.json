  },
  {
   "id": "models",
   "means": "Model list loads and a model can be picked"
  },
  {
   "id": "smoke",
   "means": "A plain prompt gets a streamed reply"
  },
  {
   "id": "tools",
   "means": "A tool call runs and shows as a tool row"
  },
  {
   "id": "permission",
   "means": "An approval request shows, Allow and Deny both work"
  },
  {
   "id": "abort",
   "means": "Stop ends the turn and the agent stays usable"
  },
  {
   "id": "resume",
   "means": "After killing the app/helper the old chat reopens and continues"
  },
  {
   "id": "network",
   "means": "Turning the network off then on recovers the turn or says why"
  },
  {
   "id": "cards",
   "means": "Agent cards (oc-ui show) answered from chat and from the list"
  }
 ],
